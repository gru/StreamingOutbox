<Project>

  <PropertyGroup>
    <!-- Строгий режим сборки: warning-as-error, анализаторы .NET (правила уровня
         preview) и стиль кода из .editorconfig проверяются при сборке.
         Все свойства поддерживаются SDK 8.0 (введены в SDK 5.0+): блокируют
         сборку так же, как scripts/lint.sh блокирует форматирование. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>preview</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Точечные правила StyleCop (SA12xx — порядок членов класса, SA1402 — один
       класс на файл). Пакет полностью выключен по категориям в .editorconfig. -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>

</Project>
