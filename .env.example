# Пароль администратора PostgreSQL (postgres). Тестовый стенд: значения по
# умолчанию унаследованы от исследовательского стенда streaming-polling-outbox.
POSTGRES_PASSWORD=postgres

# Пароль REST API Patroni (health-эндпоинты /primary, /health работают без auth).
PATRONI_API_PASSWORD=patroni

# Пароли прикладных ролей (минимальные привилегии, docs/stand.md).
SYS_WRITER_PASSWORD=writer_secret
SYS_REPLICATION_PASSWORD=replication_secret

# Роль мониторинга для postgres-exporter: подключается напрямую через
# haproxy:5432, прав — только pg_monitor (чтение статистики: replication lag,
# logical slot state, WAL retention; без REPLICATION).
SYS_MONITOR_PASSWORD=monitor_secret

# Хост-порты HTTP API (8080 на этой машине занят другим Docker-проектом).
# ВНИМАНИЕ: порты стенда совпадают со старым streaming-polling-outbox —
# оба стенда одновременно не поднять (остановить старый: docker compose stop).
WRITER_HTTP_PORT=18080
KAFKA_VALIDATOR_HTTP_PORT=18083

# Outbox-сервис (CDC outbox->Kafka): активный экземпляр cdc-outbox-1; резерв
# cdc-outbox-2 закрыт compose-профилем redundancy до реализации
# резервирования (модель — docs/stand.md).
CDC_OUTBOX_1_HTTP_PORT=18084
CDC_OUTBOX_2_HTTP_PORT=18085   # используется только при включённом профиле redundancy
