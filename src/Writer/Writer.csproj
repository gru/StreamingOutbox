<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Writer</RootNamespace>
    <AssemblyName>Writer</AssemblyName>
    <!-- Для линта IDE0005 (неиспользуемые using) в dotnet format требуется
         генерация XML-документации; CS1591 (нет XML-комментария) отключён. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- internal по умолчанию; public — контроллеры и их зависимости в сигнатурах
         (движок, писатель, конфигурация, DTO, метрики), все с XML-документацией.
         Тестовые сборки видят internal-типы через InternalsVisibleTo. -->
    <InternalsVisibleTo Include="Writer.UnitTests" />
    <InternalsVisibleTo Include="IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Пины проекта — dependencies.md §2. Writer пишет только в PostgreSQL,
         Kafka-стек ему не нужен. -->
    <PackageReference Include="Npgsql" Version="9.0.5" />
    <!-- Метрики — prometheus-net (Metrics.Create* + MapMetrics), без OTel:
         OTel-пины 1.11 закреплены за outbox-сервисом. -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="5.0.2" />
  </ItemGroup>

</Project>
