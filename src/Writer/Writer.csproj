<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Writer</RootNamespace>
    <AssemblyName>Writer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Пины проекта — dependencies.md §2. Writer пишет только в PostgreSQL,
         Kafka-стек ему не нужен. -->
    <PackageReference Include="Npgsql" Version="9.0.5" />
    <!-- Метрики — prometheus-net (Metrics.Create* + MapMetrics), без OTel:
         OTel-пины 1.11 закреплены за outbox-сервисом. -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="5.0.2" />
  </ItemGroup>

</Project>
