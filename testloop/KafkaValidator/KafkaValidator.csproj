<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KafkaValidator</RootNamespace>
    <AssemblyName>KafkaValidator</AssemblyName>
    <!-- Для линта IDE0005 (неиспользуемые using) в dotnet format требуется
         генерация XML-документации; CS1591 (нет XML-комментария) отключён. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Пины проекта — AGENTS.md «Пакеты решения». Npgsql не нужен: валидатор не подключается
         к PostgreSQL — он сверяет фактическое содержимое Kafka topic с ожидаемым
         набором id, который отдаёт Writer. Здесь используется сторона consumer. -->
    <!-- Confluent.Kafka 2.3.0 — единственный Kafka-клиент решения (сырой консюмер;
         KafkaFlow исключён 2026-10-27 из-за дефекта связки 3.0.10 + Confluent 2.3 —
         AGENTS.md, «Пакеты решения»; librdkafka.redist тянется транзитивно). -->
    <PackageReference Include="Confluent.Kafka" Version="2.3.0" />
    <!-- Метрики — prometheus-net (Metrics.Create* + MapMetrics), без OTel:
         OTel-пины 1.11 закреплены за outbox-сервисом. -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="5.0.2" />
  </ItemGroup>

</Project>
