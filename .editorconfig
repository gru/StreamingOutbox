# Строгий .editorconfig — проверяется `scripts/lint.sh` (dotnet format --verify-no-changes).
# Правила с severity warning/error блокируют линт; suggestion — зафиксированные
# предпочтения, не блокирующие. Соответствие линту обязательно при изменениях
# кода и тестов (AGENTS.md, раздел «Линт»).

root = true

# ---------- Все файлы ----------

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: два пробела в конце строки = перенос строки, не чистить
[*.md]
trim_trailing_whitespace = false

# ---------- Не-C# файлы ----------

[*.{csproj,props,targets,xml}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{sh,sql}]
indent_style = space
indent_size = 4

# ---------- C#: форматирование (dotnet format whitespace) ----------

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_label_indentation = one_less_than_current

csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_cast = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_after_comma = true
csharp_space_before_dot = false
csharp_space_after_dot = false
csharp_space_around_operators = before_and_after

# ---------- C#: стиль (dotnet format style; warning/error блокируют) ----------

# using — вне namespace, System-группой первой, группы не разделять
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Файловые namespace; Allman-скобки; без this.
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = when_multiline:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Явные модификаторы доступа; predefined-типы (string/int, не String/Int32)
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# readonly-поля, где возможно; авто-свойства; compound-присваивание
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_compound_assignment = true:warning

# Инициализаторы, target-typed new, явные имена кортежей
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_style_explicit_tuple_names = true:warning

# Неиспользуемые using (для точной работы IDE0005 в csproj включён
# GenerateDocumentationFile + NoWarn CS1591). Ключ — строго через точку:
# вариант с подчёркиванием (IDE0005_severity) молча игнорируется.
dotnet_diagnostic.IDE0005.severity = warning

# ---------- C#: предпочтения (suggestion — НЕ блокируют линт) ----------

csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_extended_property_pattern = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = false:suggestion
dotnet_style_prefer_conditional_expression_over_return = false:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion

# ---------- .NET: нейминг (порядок правил важен: первое совпадение побеждает) ----------

# const-поля (любой доступности) — PascalCase
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.required_modifiers = const
dotnet_naming_rule.const_fields_pascal_case.symbols = const_fields
dotnet_naming_rule.const_fields_pascal_case.style = pascal_case
dotnet_naming_rule.const_fields_pascal_case.severity = error

# static-поля (включая static readonly) — PascalCase
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_rule.static_fields_pascal_case.symbols = static_fields
dotnet_naming_rule.static_fields_pascal_case.style = pascal_case
dotnet_naming_rule.static_fields_pascal_case.severity = error

# private instance-поля — _camelCase
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_rule.private_instance_fields_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_instance_fields_underscore.severity = error

# Параметры и локальные — camelCase
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_rule.parameters_camel_case.symbols = parameters
dotnet_naming_rule.parameters_camel_case.style = camel_case
dotnet_naming_rule.parameters_camel_case.severity = error

dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_rule.locals_camel_case.symbols = locals
dotnet_naming_rule.locals_camel_case.style = camel_case
dotnet_naming_rule.locals_camel_case.severity = error

# Дженерик-параметры — T + PascalCase
dotnet_naming_style.t_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_pascal_case.required_prefix = T

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_rule.type_parameters_t_pascal_case.symbols = type_parameters
dotnet_naming_rule.type_parameters_t_pascal_case.style = t_pascal_case
dotnet_naming_rule.type_parameters_t_pascal_case.severity = error

# Интерфейсы — I + PascalCase
dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_i_pascal_case.symbols = interfaces
dotnet_naming_rule.interfaces_i_pascal_case.style = i_pascal_case
dotnet_naming_rule.interfaces_i_pascal_case.severity = error

# Типы (class/struct/enum/delegate) — PascalCase
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_rule.types_pascal_case.severity = error

# Методы/свойства/события/локальные функции — PascalCase
dotnet_naming_symbols.non_field_members.applicable_kinds = method, property, event, local_function
dotnet_naming_rule.non_field_members_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_pascal_case.style = pascal_case
dotnet_naming_rule.non_field_members_pascal_case.severity = error
